# MongoDB (local Docker Compose by default — see docker-compose.yml)
# Port 27018 avoids colliding with any other local MongoDB (e.g. port 27017
# already in use by another project's container on this machine).
MONGODB_URI=mongodb://localhost:27018/null-dev

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Public site URL — used for absolute URLs in metadata (Open Graph,
# canonical links, sitemap.xml). Set to the real production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary (image storage — cover images + article galleries)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed script safety switch — the seed script refuses to run unless this
# is explicitly set, to prevent accidentally seeding a non-dev database.
ALLOW_SEED=true
